# Goetschi Control — environment template.
# Copy to dashboard.env on the host and fill in real values. NEVER commit the real file.

# ══ Infrastructure ══

# Proxmox (required)
PROXMOX_HOST=10.0.60.10
PROXMOX_NODE=pve01
PROXMOX_USER=root@pam
PROXMOX_PASS=

# Metrics & logs (required)
PROMETHEUS_URL=http://10.0.60.110:9090
LOKI_URL=http://10.0.60.110:3100

# ══ Integrations ══

# GL Agent (Goetschi Labs agent for per-host actions; required for remote shell/diagnose)
GL_AGENT_TOKEN=

# Grafana (optional; for embedding dashboards)
GRAFANA_URL=http://10.0.60.110:3000

# Dokploy & Coolify (optional; for container redeploy actions)
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
COOLIFY_URL=https://coolify.example.com
COOLIFY_API_KEY=

# UniFi (optional; for network monitoring)
UNIFI_URL=https://10.0.60.1
UNIFI_USER=
UNIFI_PASS=

# LiteLLM / AI Analysis (optional; for "chat with infrastructure" feature)
LITELLM_URL=http://localhost:4000
LITELLM_KEY=

# Telegram alerts (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ══ Security & Session ══

# Emergency fallback logins (optional; environment variables only, no code defaults)
# Set these for password-based login if database is not available
PASSWORD_MICHEL=
PASSWORD_LOUIS=

# Session security (when deployed behind HTTPS reverse proxy)
# Set to "1" to enable secure cookies (only when HTTPS is available)
COOKIE_SECURE=0

# CORS origins (default: same-origin; list space-separated URLs if needed)
CORS_ORIGINS=

# Login security (configure rate limiting)
LOGIN_MAX_FAILS=5
LOGIN_BLOCK_S=300

# ══ Application ══

# Data storage
AUDIT_DB=/data/audit.db

# Display & access
DASHBOARD_URL=http://10.0.60.155:8181
PUBLIC_STATUS=0

# Web server
PORT=8080

# SSH for remote diagnostics (optional)
LXC_SSH_USER=root
LXC_SSH_PASS=

# Agent communication
AGENT_PORT=9998
AGENT_STALE_S=30

# ══ Development (not for production) ══

# Development key for testing (never commit real values)
GL_HERMES_DEV_KEY=

# Restart behavior
NC_AUTO_RESTART=
