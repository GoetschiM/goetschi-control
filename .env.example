# RRM — alle Werte sind optional. Ohne Konfiguration startet RRM leer und
# führt dich im Browser durch die Ersteinrichtung (Administrator anlegen).
# Kopiere diese Datei nach .env und trage nur das ein, was du nutzen willst.

# Anzeigename
BRAND_NAME=RRM

# ── Proxmox (erkennt Container automatisch) ──
PROXMOX_HOST=
# Empfohlen: API-Token mit Rolle PVEAuditor (Format user@realm!tokenid=secret)
PROXMOX_TOKEN=
# PROXMOX_NODE=            # leer = automatisch

# ── UniFi ──
UNIFI_URL=
UNIFI_USER=
UNIFI_PASS=

# ── Metriken / Logs (optional) ──
PROMETHEUS_URL=
LOKI_URL=
GRAFANA_URL=

# ── Deployment-Tools (optional) ──
DOKPLOY_URL=
DOKPLOY_API_KEY=
COOLIFY_URL=
COOLIFY_API_KEY=

# ── KI-Analyse (optional, OpenAI-kompatibel, z.B. LiteLLM) ──
LITELLM_URL=
LITELLM_KEY=

# ── Alarme (optional) ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Single Sign-on (OpenID Connect, z.B. Authentik, Keycloak, Entra ID) ──
# Redirect-URI beim Identity Provider: <DASHBOARD_URL>/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
# Mitglieder dieser Gruppe werden Admin, alle anderen erhalten OIDC_DEFAULT_ROLE (viewer)
OIDC_ADMIN_GROUP=
OIDC_DEFAULT_ROLE=viewer
# 1 = Passwort-Login ausblenden (nur SSO)
OIDC_ONLY=0

# ── Zugriff ──
# Öffentliche URL des Dashboards (wird in Agent-Installer und MCP-Befehle eingesetzt)
DASHBOARD_URL=
# Auf 1 setzen, wenn das Dashboard hinter HTTPS läuft
COOKIE_SECURE=0
# Optional statt Browser-Einrichtung: Administrator aus der Umgebung anlegen
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# Agent-/MCP-Token werden beim ersten Start automatisch erzeugt (unter "Verbinden" sichtbar).
# Zum Festlegen: GL_AGENT_TOKEN=..., MCP_TOKEN=...

# Zusätzliche Links in der Übersicht (JSON-Liste)
# EXTERNAL_LINKS=[{"name":"Wiki","url":"https://wiki.example.com","icon":"📝","desc":"Wiki"}]
